{
  "name": "interactive-3d-data-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch backend/src/index.ts",
    "dev:all": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"tsx watch backend/src/index.ts\" \"vite\"",
    "dev:host": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"tsx backend/src/index.ts\" \"vite --host 0.0.0.0 --port 3000\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:api": "node --import tsx --test tests/integration/system-api.integration.ts",
    "test:e2e": "playwright test",
    "maintenance:datasets": "node --import tsx backend/src/maintenance/purgeDatasets.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scarfSettings": {
    "enabled": false
  }
}
