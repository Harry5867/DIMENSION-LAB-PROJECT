PORT=5000
LAB_BIND_HOST=127.0.0.1

# Use atlas to enable persistent storage and Google sign-in.
LAB_STORAGE_MODE=demo
MONGODB_URI=
MONGODB_DB=dimension_lab_dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side email verification for first-time manual sign-in (Resend verified sender).
RESEND_API_KEY=
LAB_EMAIL_FROM=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Atlas account quota. Trash is counted separately in the cluster's physical usage.
LAB_DATASET_MAX_FILES=20
LAB_DATASET_MAX_MIB=30
# Set only for a private workspace. Leave empty to allow all eligible accounts.
LAB_ALLOWED_EMAILS=
# Exact frontend origin, required for Atlas cookie-authenticated writes.
LAB_ALLOWED_ORIGIN=
# Workload limits apply by default in production. Set to 1 for local verification.
LAB_LIMITS_ENABLED=
LAB_UPLOADS_PER_MINUTE=30
LAB_UPLOAD_CONCURRENCY=2
LAB_ANALYSES_PER_MINUTE=30
LAB_ANALYSIS_CONCURRENCY=2
LAB_ENABLE_HSTS=
