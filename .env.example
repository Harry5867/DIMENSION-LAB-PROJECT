# Existing analysis API
PORT=5000

# Native MongoDB Community Server on this computer (bind MongoDB to 127.0.0.1)
MONGODB_URI=mongodb://127.0.0.1:27017/cancer_explorer
MONGODB_DB_NAME=cancer_explorer

# Local-first account and dataset API; its code binds to 127.0.0.1 only
LOCAL_DATA_PORT=5100

# Local accounts do not send email or require SMTP verification.
# Keep secrets in the ignored .env file, never in this template or Git.
